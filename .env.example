# Salin ke .env (lokal) atau isi di Vercel > Settings > Environment Variables. JANGAN commit file .env.

# Rahasia untuk /api/tick dan /api/kill. Buat string acak panjang (contoh: 40 karakter acak).
CRON_SECRET=

# Upstash Redis (otomatis terisi kalau dipasang lewat Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kill switch lewat env var: 1 = hentikan semua order baru
KILL_SWITCH=0
